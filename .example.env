# ─── AI Provider Configuration ───────────────────────────────────────────────
# Only free providers are supported:
#   1. OpenCode Zen — free models via OPENAI_COMPATIBLE_*
#   2. Mock (fallback — no key needed, returns canned components)
#
# If a configured free model hits a rate limit or transient failure, the app
# automatically rotates through the remaining free models before falling back
# to the mock provider, so users always get a working result.
#
# Copy this file to .env and fill in your chosen provider's values.
# The project runs without any API key — mock mode is used automatically.


# ─── OpenCode Zen (recommended) ──────────────────────────────────────────────
# Free models (pickable in the UI), in order:
#   big-pickle (default), hy3-free, ling-3.0-flash-fin-free.
# OPENAI_COMPATIBLE_MODEL must be one of those free ids — any other value
# (e.g. claude-haiku-4-5, gpt-5.4-mini) silently falls back to
# big-pickle. Get your key at https://opencode.ai/auth
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_BASE_URL=https://opencode.ai/zen/v1
OPENAI_COMPATIBLE_MODEL=big-pickle


# ─── Site (optional — auto-derived from request host) ───────────────────────
# Optional override for the public URL used in OpenGraph metadata and OG image
# footers. When unset, the request host is used automatically (custom domains
# included), falling back to VERCEL_URL, then http://localhost:3000.
NEXT_PUBLIC_APP_URL=


# ─── Database (required) ────────────────────────────────────────────────────
# Neon Postgres connection strings — get yours at https://console.neon.tech
DATABASE_URL="postgresql://user:password@your-endpoint.neon.tech/dbname?channel_binding=require&sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://user:password@your-endpoint.neon.tech/dbname?channel_binding=require&sslmode=require"
NEON_BRANCH=production


# ─── Neon Auth (required for user accounts) ──────────────────────────────────
# Neon Auth gateway — see https://neon.tech/docs/guides/neon-auth
NEON_AUTH_BASE_URL=https://your-endpoint.neonauth.neon.tech/dbname/auth
NEON_AUTH_COOKIE_SECRET=


# ─── Sentry (optional error tracking + tracing) ──────────────────────────────
# Get a DSN at https://sentry.io (Project Settings > Client Keys).
# SENTRY_AUTH_TOKEN is only needed at build time to upload source maps.
SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
